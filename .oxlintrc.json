{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-hooks", "typescript", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "eslint/eqeqeq": ["error", "smart"],
    "eslint/no-unused-vars": [
      "error",
      {
        "args": "none",
        "ignoreRestSiblings": true,
        "varsIgnorePattern": "^_"
      }
    ],
    "import/no-cycle": "error",
    "react/react-in-jsx-scope": "off",
    "eslint/no-underscore-dangle": "off",
    "import/no-named-as-default-member": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.output/**",
    "**/.parlor/**",
    "docs/**",
    "**/routeTree.gen.ts"
  ],
  "overrides": [
    {
      "files": [
        "packages/chat/src/**/*.{ts,tsx}",
        "packages/client/src/react/chat/**/*.{ts,tsx}"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "zod",
                "message": "The browser bundle must not ship zod; validate by hand here and keep schemas in server code."
              }
            ],
            "patterns": [
              {
                "group": ["zod/*"],
                "message": "The browser bundle must not ship zod; validate by hand here and keep schemas in server code."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/chat/src/server/**",
        "packages/chat/src/items.ts",
        "packages/chat/src/id-schemas.ts",
        "packages/chat/src/**/*.spec.ts",
        "packages/chat/src/**/*.spec-d.ts",
        "packages/client/src/react/chat/**/*.spec.{ts,tsx}"
      ],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    }
  ]
}
