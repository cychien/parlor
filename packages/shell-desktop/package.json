{
  "name": "@parlor/shell-desktop",
  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://cychien.github.io/parlor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cychien/parlor.git",
    "directory": "packages/shell-desktop"
  },
  "bugs": "https://github.com/cychien/parlor/issues",
  "files": [
    "dist",
    "assets",
    "rust/Cargo.toml",
    "rust/src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@parlor/config": "workspace:*",
    "@parlor/shell-web": "workspace:*",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/cli": "^2.12.1",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@parlor/agent-host-darwin-arm64": "workspace:*"
  }
}
