{
  "name": "@parlor/agent-host",
  "version": "0.0.0",
  "bin": {
    "parlor-host": "./bin/parlor-host-dev.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/fake-agent.ts",
    "./scripts/release.mjs": "./scripts/release.mjs"
  },
  "publishConfig": {
    "bin": {
      "parlor-host": "./dist/main.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/fake-agent.d.ts",
        "import": "./dist/testing/fake-agent.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.9.0",
    "@parlor/auth": "workspace:*",
    "@parlor/capabilities": "workspace:*",
    "@parlor/chat": "workspace:*",
    "@parlor/client": "workspace:*",
    "@parlor/core": "workspace:*",
    "@parlor/server": "workspace:*",
    "@parlor/sync": "workspace:*",
    "citty": "^0.2.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.93.0",
    "@agentclientprotocol/codex-acp": "2.2.2",
    "@parlor/data": "workspace:*",
    "@types/node": "catalog:",
    "better-auth": "1.7.7",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "srvx": "^1.0.5",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
