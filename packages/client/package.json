{
  "name": "@parlor/client",
  "version": "0.3.1",
  "homepage": "https://cychien.github.io/parlor",
  "bugs": "https://github.com/cychien/parlor/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cychien/parlor.git",
    "directory": "packages/client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./router": "./src/router/index.ts",
    "./ssr": "./src/ssr/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react/index.d.ts",
        "import": "./dist/react/index.js"
      },
      "./router": {
        "types": "./dist/router/index.d.ts",
        "import": "./dist/router/index.js"
      },
      "./ssr": {
        "types": "./dist/ssr/index.d.ts",
        "import": "./dist/ssr/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@parlor/agent-ui": "workspace:*",
    "@parlor/capabilities": "workspace:*",
    "@parlor/chat": "workspace:*",
    "@parlor/core": "workspace:*",
    "@parlor/sync": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.102",
    "@tanstack/react-router": ">=1.170",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    }
  }
}
