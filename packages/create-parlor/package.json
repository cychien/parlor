{
  "name": "create-parlor",
  "version": "0.3.2",
  "description": "Create a Parlor app: pnpm create parlor, npm create parlor, yarn create parlor, bun create parlor",
  "homepage": "https://cychien.github.io/parlor",
  "bugs": "https://github.com/cychien/parlor/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cychien/parlor.git",
    "directory": "packages/create-parlor"
  },
  "bin": {
    "create-parlor": "./bin/create-parlor-dev.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "bin": {
      "create-parlor": "./dist/main.js"
    }
