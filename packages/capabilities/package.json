{
  "name": "@parlor/capabilities",
  "version": "0.3.0",
  "homepage": "https://cychien.github.io/parlor",
  "bugs": "https://github.com/cychien/parlor/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cychien/parlor.git",
    "directory": "packages/capabilities"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#adapters": {
      "parlor-tauri": "./src/adapters/tauri.ts",
      "parlor-capacitor": "./src/adapters/capacitor.ts",
      "default": "./src/adapters/web.ts"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./encoding": "./src/device-key/encoding.ts"
  },
  "publishConfig": {
    "imports": {
      "#adapters": {
        "parlor-tauri": "./dist/adapters/tauri.js",
        "parlor-capacitor": "./dist/adapters/capacitor.js",
        "default": "./dist/adapters/web.js"
      }
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./encoding": {
        "types": "./dist/device-key/encoding.d.ts",
        "import": "./dist/device-key/encoding.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@parlor/capacitor-device-key": "workspace:*",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@types/node": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@capacitor/app": ">=8",
    "@capacitor/filesystem": ">=8",
    "@capacitor/local-notifications": ">=8",
    "@capacitor/share": ">=8",
    "@parlor/capacitor-device-key": ">=0",
    "@tauri-apps/api": ">=2",
    "@tauri-apps/plugin-deep-link": ">=2",
    "@tauri-apps/plugin-dialog": ">=2",
    "@tauri-apps/plugin-fs": ">=2",
    "@tauri-apps/plugin-notification": ">=2"
  },
  "peerDependenciesMeta": {
    "@capacitor/app": {
      "optional": true
    },
    "@capacitor/filesystem": {
      "optional": true
    },
    "@capacitor/local-notifications": {
      "optional": true
    },
    "@capacitor/share": {
      "optional": true
    },
    "@parlor/capacitor-device-key": {
      "optional": true
    },
    "@tauri-apps/api": {
      "optional": true
    },
    "@tauri-apps/plugin-deep-link": {
      "optional": true
    },
    "@tauri-apps/plugin-dialog": {
      "optional": true
    },
    "@tauri-apps/plugin-fs": {
      "optional": true
    },
    "@tauri-apps/plugin-notification": {
      "optional": true
    }
  }
}
