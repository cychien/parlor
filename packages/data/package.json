{
  "name": "@parlor/data",
  "version": "0.3.1",
  "homepage": "https://cychien.github.io/parlor",
  "bugs": "https://github.com/cychien/parlor/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cychien/parlor.git",
    "directory": "packages/data"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#platform": {
      "workerd": "./src/platform.workerd.ts",
      "default": "./src/platform.ts"
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "imports": {
      "#platform": {
        "workerd": "./dist/platform.workerd.js",
        "default": "./dist/platform.js"
      }
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@parlor/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
