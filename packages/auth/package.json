{
  "name": "@parlor/auth",
  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://cychien.github.io/parlor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cychien/parlor.git",
    "directory": "packages/auth"
  },
  "bugs": "https://github.com/cychien/parlor/issues",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./schema": "./src/schema.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./schema": {
        "types": "./dist/schema.d.ts",
        "import": "./dist/schema.js",
        "default": "./dist/schema.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@parlor/capabilities": "workspace:*",
    "@parlor/chat": "workspace:*",
    "@parlor/client": "workspace:*",
    "@parlor/core": "workspace:*",
    "@parlor/server": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@parlor/data": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "auth": "1.7.7",
    "pg": "^8.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
