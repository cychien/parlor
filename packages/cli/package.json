{
  "name": "@parlor/cli",
  "version": "0.3.3",
  "homepage": "https://cychien.github.io/parlor",
  "bugs": "https://github.com/cychien/parlor/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cychien/parlor.git",
    "directory": "packages/cli"
  },
  "bin": {
    "parlor": "./bin/parlor-dev.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "bin": {
      "parlor": "./dist/main.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@parlor/agent-host": "workspace:*",
    "@parlor/agent-ui": "workspace:*",
    "@parlor/config": "workspace:*",
    "@parlor/data": "workspace:*",
    "@parlor/host": "workspace:*",
    "@parlor/scaffold": "workspace:*",
    "@parlor/shell-desktop": "workspace:*",
    "@parlor/shell-mobile": "workspace:*",
    "@parlor/shell-web": "workspace:*",
    "citty": "^0.2.2",
    "drizzle-kit": "^0.31.11",
    "srvx": "^1.0.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@parlor/core": "workspace:*",
    "@parlor/server": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-orm": "^0.45.4",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.152.0",
    "zod": "catalog:"
