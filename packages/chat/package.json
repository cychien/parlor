{
  "name": "@parlor/chat",
  "version": "0.3.1",
  "homepage": "https://cychien.github.io/parlor",
  "bugs": "https://github.com/cychien/parlor/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cychien/parlor.git",
    "directory": "packages/chat"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@parlor/agent-ui": "workspace:*",
    "@parlor/core": "workspace:*",
    "@parlor/server": "workspace:*",
    "@parlor/sync": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@parlor/data": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
