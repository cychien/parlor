    "starlight-links-validator": "0.27.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@parlor/auth": "workspace:*",
    "@parlor/capabilities": "workspace:*",
    "@parlor/chat": "workspace:*",
    "@parlor/cli": "workspace:*",
    "@parlor/client": "workspace:*",
    "@parlor/config": "workspace:*",
    "@parlor/core": "workspace:*",
    "@parlor/data": "workspace:*",
    "@parlor/server": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "better-auth": "1.7.7",
    "create-parlor": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "react": "catalog:",
